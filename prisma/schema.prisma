generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String
  phone            String?
  address          String?
  role             Role     @default(CUSTOMER)
  createdAt        DateTime @default(now())
  emailVerified    Boolean  @default(false)
  verificationCode String?
  orders           Order[]
  resetCode         String?
  resetCodeExpiry   DateTime?
  resetAttempts    Int       @default(0)
  resetLockedUntil DateTime?
  verificationCodeExpiry DateTime?
  promoUsages      PromoCodeUsage[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          String           @id @default(cuid())
  categoryId  String
  name        String
  description String?
  price       Decimal
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  color         Color
  size          Size
  sku           String?     @unique
  stockQuantity Int         @default(0)
  openingStock  Int         @default(0)
  orderItems    OrderItem[]
  product       Product     @relation(fields: [productId], references: [id])
}

model Order {
  id                    String        @id @default(cuid())
  invoiceNumber         Int?          @unique
  userId                String?
  totalAmount           Decimal
  discountAmount        Decimal       @default(0)
  promoCode             String?
  status                OrderStatus   @default(PENDING)
  paymentId             String?
  paymentStatus         PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  guestEmail            String?
  user                  User?         @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  address               String?
  phone                 String?
  clientOrderId         String?       @unique
  verifyToken           String?       @unique
  lastPaymentCheckAt    DateTime?
  paymobTransactionId   String?
  confirmationEmailSent Boolean       @default(false)
  adminEmailSent        Boolean       @default(false)

  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId])
  @@index([paymobTransactionId])
}

model OrderItem {
  id                  String         @id @default(cuid())
  orderId             String
  variantId           String
  productNameSnapshot String
  priceSnapshot       Decimal
  colorSnapshot       String
  sizeSnapshot        String
  quantity            Int
  order               Order          @relation(fields: [orderId], references: [id])
  variant             ProductVariant @relation(fields: [variantId], references: [id])
}

model InvoiceCounter {
  id      Int @id @default(1)
  lastNum Int @default(0)
}

model PromoCode {
  id         String           @id @default(cuid())
  code       String           @unique
  discount   Int
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  usages     PromoCodeUsage[]
}

model PromoCodeUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  userId      String?
  phone       String
  usedAt      DateTime  @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@unique([promoCodeId, phone])
  @@index([promoCodeId])
  @@index([phone])
  @@index([userId])
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Color {
  BLACK
  WHITE
  GREY
  BEIGE
}

enum Size {
  M
  L
  XL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}