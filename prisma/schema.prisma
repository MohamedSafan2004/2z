generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String
  phone            String?
  address          String?
  role             Role     @default(CUSTOMER)
  createdAt        DateTime @default(now())
  emailVerified    Boolean  @default(false)
  verificationCode String?
  orders           Order[]
  resetCode         String?
  resetCodeExpiry   DateTime?
  resetAttempts    Int       @default(0)
  resetLockedUntil DateTime?
  verificationCodeExpiry DateTime?
  tokenVersion     Int       @default(0)
  promoUsages      PromoCodeUsage[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id            String           @id @default(cuid())
  categoryId    String
  name          String
  description   String?
  price         Decimal
  originalPrice Decimal?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  category      Category         @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  color         Color
  size          Size
  sku           String?     @unique
  stockQuantity Int         @default(0)
  openingStock  Int         @default(0)
  orderItems    OrderItem[]
  product       Product     @relation(fields: [productId], references: [id])
}

model Order {
  id                    String        @id @default(cuid())
  invoiceNumber         Int?          @unique
  userId                String?
  totalAmount           Decimal
  discountAmount        Decimal       @default(0)
  tierDiscountPercent   Int           @default(0) // خصم الكمية المتدرج الفعلي المطبق (0/10/20/30/40) — لو البرومو كود أعلى منه، discountAmount بيعكس قيمة البرومو والحقل ده بيفضل 0
  promotionDiscount     Decimal       @default(0)
  shippingCost          Decimal       @default(0)
  shippingZone          String?
  promoCode             String?
  status                OrderStatus   @default(PENDING)
  paymentMethod         PaymentMethod @default(COD)
  paymentId             String?
  paymentStatus         PaymentStatus @default(PENDING)
  instapayRef           String?
  createdAt             DateTime      @default(now())
  guestEmail            String?
  guestName             String?
  user                  User?         @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  address               String?
  city                  String?
  phone                 String?
  clientOrderId         String?       @unique
  verifyToken           String?       @unique
  lastPaymentCheckAt    DateTime?
  paymobTransactionId   String?
  confirmationEmailSent Boolean       @default(false)
  adminEmailSent        Boolean       @default(false)
  sheetSynced           Boolean       @default(false)
  abandonedCartEmailSentAt DateTime?  // وقت إرسال ريمايندر الـ InstaPay المتروك بدون دفع — null لحد ما يتبعت

  // ─── Bosta — متفعّلة بالكامل (lib/bosta.ts + lib/bosta-sync.ts + زرار "Send to Bosta" في الأدمن) ───
  bostaDeliveryId       String?       @unique // معرف الشحنة عند Bosta
  bostaTrackingNumber   String?       // رقم التتبع اللي بيظهر للعميل
  bostaState            String?       // آخر حالة معروفة من Bosta (created, pickedUp, inTransit, delivered, إلخ...)
  bostaCreatedAt        DateTime?     // وقت إنشاء الشحنة عند Bosta
  bostaLastSyncAt       DateTime?     // آخر مرة اتحدثت فيها حالة الشحنة من Bosta

  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId])
  @@index([paymobTransactionId])
  @@index([status])
}

model OrderItem {
  id                  String         @id @default(cuid())
  orderId             String
  variantId           String
  productNameSnapshot String
  priceSnapshot       Decimal
  colorSnapshot       String
  sizeSnapshot        String
  quantity            Int
  isGift              Boolean        @default(false)
  order               Order          @relation(fields: [orderId], references: [id])
  variant             ProductVariant @relation(fields: [variantId], references: [id])
}

model InvoiceCounter {
  id      Int @id @default(1)
  lastNum Int @default(0)
}

model PromoCode {
  id         String           @id @default(cuid())
  code       String           @unique
  discount   Int
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  usages     PromoCodeUsage[]
}

model PromoCodeUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  userId      String?
  phone       String
  usedAt      DateTime  @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@unique([promoCodeId, phone])
  @@index([promoCodeId])
  @@index([phone])
  @@index([userId])
}

model Promotion {
  id              String        @id @default(cuid())
  type            PromotionType @default(BUY_X_GET_Y_FREE)
  triggerQuantity Int
  freeQuantity    Int
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@index([isActive])
}

model EmailLead {
  id             String   @id @default(cuid())
  email          String   @unique
  promoCode      String
  source         String   @default("popup_10off")
  createdAt      DateTime @default(now())
  codeExpiresAt  DateTime // صلاحية الكود للإيميل ده بالذات — 48 ساعة من وقت التسجيل

  @@index([createdAt])
  @@index([email, codeExpiresAt])
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Color {
  BLACK
  WHITE
  GREY
  BEIGE
}

enum Size {
  M
  L
  XL
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  COD
  INSTAPAY
}

enum PromotionType {
  BUY_X_GET_Y_FREE
}